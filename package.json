{
  "name": "mediadesk",
  "private": true,
  "version": "0.8.1",
  "description": "媒材工坊 MediaDesk — 自媒体灵感与素材工作台",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "server": "cargo run -p mediadesk-server --",
    "server:release": "cargo build --release -p mediadesk-server && ./target/release/mediadesk-server --open",
    "app:dev": "npm run build && tauri dev",
    "app:build": "npm run build && tauri build",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run e2e:prepare && playwright test",
    "typecheck": "tsc --noEmit",
    "rust:test": "cargo test --workspace --exclude mediadesk-desktop",
    "check": "npm run typecheck && npm run test && npm run rust:test",
    "e2e:prepare": "npm run build && cargo build -p mediadesk-server"
  },
  "dependencies": {
    "dompurify": "^3.4.18",
    "marked": "^16.4.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.6",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}
