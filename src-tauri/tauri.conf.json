{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "媒材工坊",
  "version": "0.6.0",
  "identifier": "com.mediadesk.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "自媒体灵感与素材工作台",
    "longDescription": "媒材工坊 MediaDesk 是本地优先的自媒体灵感、项目与五类素材管理工作台。",
    "copyright": "MediaDesk",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
